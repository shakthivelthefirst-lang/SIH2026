{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Remote Attach (Port 5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "${workspaceFolder}"
        }
      ]
    },
    {
      "name": "Python: Web Application (app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: ML Model Pipeline (ml_model.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ml_model.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Training Pipeline (train.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": [
        "--epochs", "5",
        "--batch_size", "8"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Python: System Test Suite (test_system.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_system.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Real-Time Audio Streamer (realtime_demo.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/realtime_demo.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Visualizer (visualize.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/visualize.py",
      "console": "integratedTerminal"
    }
  ]
}
